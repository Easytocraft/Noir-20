<div class="noir-sheet item-sheet">
  <header class="sheet-header">
    <img class="portrait small" src="{{item.img}}" data-edit="img" data-action="editImage" alt="">
    <div class="head-fields"><input class="name" type="text" name="name" value="{{item.name}}"></div>
  </header>
  <div class="sheet-body">
    <div class="fields">
    {{#if is.weapon}}
      <label>{{localize "NOIR.Damage"}} <input type="text" name="system.damage" value="{{system.damage}}"></label>
      <label>{{localize "NOIR.DamageType"}} <input type="text" name="system.damageType" value="{{system.damageType}}"></label>
      <label>{{localize "NOIR.Ability.str"}}/{{localize "NOIR.Ability.dex"}}
        <select name="system.ability">{{selectOptions weaponAbilities selected=system.ability localize=true}}</select></label>
      <label>{{localize "NOIR.Range"}} <input type="text" name="system.range" value="{{system.range}}"></label>
      <label>{{localize "NOIR.Properties"}} <input type="text" name="system.properties" value="{{system.properties}}"></label>
      <label>{{localize "NOIR.AttackBonus"}} <input type="number" name="system.attackBonus" value="{{system.attackBonus}}"></label>
      <label>{{localize "NOIR.Ammo"}} <input type="number" name="system.ammo.value" value="{{system.ammo.value}}"></label>
      <label>{{localize "NOIR.MaxAmmo"}} <input type="number" name="system.ammo.max" value="{{system.ammo.max}}"></label>
      <label>{{localize "NOIR.Proficient"}} <input type="checkbox" name="system.proficient" {{checked system.proficient}}></label>
    {{/if}}
    {{#if is.armor}}
      <label>{{localize "NOIR.Kind"}} <select name="system.kind">{{selectOptions armorKinds selected=system.kind localize=true}}</select></label>
      <label>{{localize "NOIR.AC"}} <input type="number" name="system.ac" value="{{system.ac}}"></label>
      <label>{{localize "NOIR.MaxDex"}} <input type="number" name="system.maxDex" value="{{system.maxDex}}"></label>
      <label>{{localize "NOIR.StealthDis"}} <input type="checkbox" name="system.stealthDis" {{checked system.stealthDis}}></label>
      <label>{{localize "NOIR.Equipped"}} <input type="checkbox" name="system.equipped" {{checked system.equipped}}></label>
    {{/if}}
    {{#if is.gear}}
      <label>{{localize "NOIR.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}"></label>
    {{/if}}
    {{#if is.class}}
      <label>{{localize "NOIR.HitDie"}} <input type="text" name="system.hitDie" value="{{system.hitDie}}"></label>
      <label>{{localize "NOIR.Saves"}} <input type="text" name="system.saves" value="{{system.saves}}"></label>
      <label class="wide">{{localize "NOIR.Proficiencies"}} <input type="text" name="system.proficiencies" value="{{system.proficiencies}}"></label>
      <label class="wide">{{localize "NOIR.SkillChoice"}} <input type="text" name="system.skills" value="{{system.skills}}"></label>
    {{/if}}
    {{#if is.species}}
      <label class="wide">{{localize "NOIR.ASI"}} <input type="text" name="system.asi" value="{{system.asi}}"></label>
      <label>{{localize "NOIR.Size"}} <input type="text" name="system.size" value="{{system.size}}"></label>
      <label>{{localize "NOIR.Speed"}} <input type="number" step="0.5" name="system.speed" value="{{system.speed}}"></label>
    {{/if}}
    {{#if is.background}}
      <label class="wide">{{localize "NOIR.SkillChoice"}} <input type="text" name="system.skills" value="{{system.skills}}"></label>
      <label class="wide">{{localize "NOIR.Tools"}} <input type="text" name="system.tools" value="{{system.tools}}"></label>
      <label class="wide">{{localize "NOIR.Equipment"}} <input type="text" name="system.equipment" value="{{system.equipment}}"></label>
    {{/if}}
    {{#if is.subclass}}
      <label class="wide">{{localize "TYPES.Item.class"}} <input type="text" name="system.class" value="{{system.class}}"></label>
    {{/if}}
    {{#if is.feature}}
      <label>{{localize "NOIR.Level"}} <input type="number" name="system.level" value="{{system.level}}"></label>
      <label>{{localize "NOIR.Source"}} <input type="text" name="system.source" value="{{system.source}}"></label>
      <label>{{localize "NOIR.Cost"}} <input type="text" name="system.cost" value="{{system.cost}}"></label>
    {{/if}}
    {{#if hasPrice}}
      <label>{{localize "NOIR.Weight"}} <input type="number" step="0.1" name="system.weight" value="{{system.weight}}"></label>
      <label>{{localize "NOIR.Price"}} <input type="number" step="0.5" name="system.price" value="{{system.price}}"></label>
    {{/if}}
    </div>
    <h3>{{localize "NOIR.Description"}}</h3>
    <prose-mirror name="system.description" value="{{system.description}}" toggled="true" collaborate="false">{{{enriched}}}</prose-mirror>
  </div>
</div>
