<div class="wizard">
  <nav class="dtabs">
    {{#each tabs}}<a class="dtab {{#if active}}active{{/if}} {{#if done}}done{{/if}}" data-action="goTab" data-tab="{{id}}"><span class="n">{{n}}</span>{{label}}</a>{{/each}}
  </nav>
  <div class="paper-wrap"><section class="paper">
    <div class="body">

    {{#if t.class}}
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Group.class"}}</span></h4>
        <div class="slot {{#if cls}}filled{{/if}}" data-action="pick" data-kind="class" data-drop="class">
          {{#if cls}}{{#if cls.img}}<img class="pic" src="{{cls.img}}" alt="">{{else}}<i class="glyph g-class big"></i>{{/if}}<div class="info"><b>{{cls.name}}</b><span>{{cls.focus}}</span></div><a class="x" data-action="clear" data-kind="class">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.class"}}</span><span class="plus">＋</span>{{/if}}
        </div>
      </div>
      {{#if cls}}
      <div class="detail">
        <p class="sum">{{{cls.summary}}}</p>
        <div class="chips"><span class="pill">{{localize "NOIR.Evasion"}} {{cls.evasion}}</span><span class="pill">{{localize "NOIR.Wounds"}} {{cls.wounds}}</span><span class="pill">{{localize "NOIR.Stress"}} {{cls.stress}}</span></div>
        <h4 class="legend small"><span>{{localize "NOIR.ClassTrait"}}</span></h4>
        {{#each cls.trait}}<div class="feat"><img class="pic s" src="{{img}}" alt=""><b>{{name}}</b>{{#if modsText}} <em>({{modsText}})</em>{{/if}}<div>{{{desc}}}</div></div>{{/each}}
        <h4 class="legend small"><span>{{localize "NOIR.ChooseAbilities"}}: {{abilitiesLeft}}</span></h4>
        <div class="cards">
          {{#each abilities}}
          <a class="card {{#if on}}on{{/if}}" data-action="toggleAbility" data-id="{{id}}">
            <img class="pic" src="{{img}}" alt=""><div class="txt"><b>{{name}}</b>{{#if cost}}<em>{{cost}}</em>{{/if}}<span>{{{desc}}}</span></div>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}
    {{/if}}

    {{#if t.species}}
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Group.species"}}</span></h4>
        <div class="slot {{#if species}}filled{{/if}}" data-action="pick" data-kind="species" data-drop="species">
          {{#if species}}{{#if species.img}}<img class="pic" src="{{species.img}}" alt="">{{else}}<i class="glyph g-species big"></i>{{/if}}<div class="info"><b>{{species.name}}</b><span>{{species.size}}</span></div><a class="x" data-action="clear" data-kind="species">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.species"}}</span><span class="plus">＋</span>{{/if}}
        </div>
        <a class="chip toggle {{#if mixed}}on{{/if}}" data-action="toggleMixed">{{#if mixed}}☑{{else}}☐{{/if}} {{localize "NOIR.Mixed"}}</a>
        {{#if mixed}}
        <div class="slot {{#if species2}}filled{{/if}}" data-action="pick" data-kind="species2" data-drop="species2">
          {{#if species2}}{{#if species2.img}}<img class="pic" src="{{species2.img}}" alt="">{{else}}<i class="glyph g-species big"></i>{{/if}}<div class="info"><b>{{species2.name}}</b><span>{{species2.size}}</span></div><a class="x" data-action="clear" data-kind="species2">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.species2"}}</span><span class="plus">＋</span>{{/if}}
        </div>
        {{/if}}
      </div>
      {{#if species}}
      <div class="detail">
        <div class="desc">{{{species.desc}}}</div>
        <h4 class="legend small"><span>{{species.name}}: {{#if mixed}}{{localize "NOIR.PickOneTrait"}}{{else}}{{localize "NOIR.Features"}}{{/if}}</span></h4>
        <div class="cards">
          {{#each species.traits}}
          <a class="card {{#if on}}on{{/if}}" {{#if ../mixed}}data-action="pickTrait" data-which="A" data-id="{{id}}"{{/if}}>
            <img class="pic" src="{{img}}" alt=""><div class="txt"><b>{{name}}</b>{{#if modsText}}<em>{{modsText}}</em>{{/if}}<span>{{{desc}}}</span></div>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{#if species2}}
      <div class="detail">
        <h4 class="legend small"><span>{{species2.name}}: {{localize "NOIR.PickOneTrait"}}</span></h4>
        <div class="cards">
          {{#each species2.traits}}
          <a class="card {{#if on}}on{{/if}}" data-action="pickTrait" data-which="B" data-id="{{id}}">
            <img class="pic" src="{{img}}" alt=""><div class="txt"><b>{{name}}</b>{{#if modsText}}<em>{{modsText}}</em>{{/if}}<span>{{{desc}}}</span></div>
          </a>
          {{/each}}
        </div>
      </div>
      {{/if}}
    {{/if}}

    {{#if t.background}}
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Group.background"}}</span></h4>
        <div class="slot {{#if background}}filled{{/if}}" data-action="pick" data-kind="background" data-drop="background">
          {{#if background}}{{#if background.img}}<img class="pic" src="{{background.img}}" alt="">{{else}}<i class="glyph g-background big"></i>{{/if}}<div class="info"><b>{{background.name}}</b><span>${{background.cash}}</span></div><a class="x" data-action="clear" data-kind="background">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.background"}}</span><span class="plus">＋</span>{{/if}}
        </div>
      </div>
      {{#if background}}
      <div class="detail">
        <div class="desc">{{{background.desc}}}</div>
        <h4 class="legend small"><span>{{localize "NOIR.OriginTrait"}}</span></h4>
        {{#each background.trait}}<div class="feat"><img class="pic s" src="{{img}}" alt=""><b>{{name}}</b><div>{{{desc}}}</div></div>{{/each}}
        <h4 class="legend small"><span>{{localize "NOIR.StartItems"}}</span></h4>
        <div class="chips">{{#each background.items}}<span class="pill">{{this}}</span>{{/each}}<span class="pill cash">${{background.cash}}</span></div>
      </div>
      {{/if}}
    {{/if}}

    {{#if t.stats}}
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Group.stats"}} {{statsAssigned}}/6</span></h4>
        <div class="recommend">
          <h4 class="legend small"><span>{{localize "NOIR.Recommended"}}</span></h4>
          {{#if hasClass}}
          <div class="chips">{{#each recommended}}<span class="pill">{{label}} {{value}}</span>{{/each}}</div>
          <button type="button" class="btn ghost" data-action="recommended">{{localize "NOIR.UseRecommended"}}</button>
          {{else}}<p class="hint">{{localize "NOIR.PickClassFirst"}}</p>{{/if}}
        </div>
        <div class="cells">
          {{#each cells}}
          <div class="cell">
            <label>{{label}}</label>
            <select data-bind="stat.{{key}}">{{#each options}}<option value="{{v}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            
          </div>
          {{/each}}
        </div>
        {{#unless statsOk}}<p class="hint">{{localize "NOIR.StatsHint"}}</p>{{/unless}}
      </div>
    {{/if}}

    {{#if t.persona}}
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Vice"}}</span></h4>
        <div class="chips big">{{#each vices}}<a class="chip {{#if on}}on{{/if}}" data-action="chip" data-field="vice" data-value="{{value}}">{{value}}</a>{{/each}}</div>
        <input type="text" class="wide" data-bind="vice" value="{{vice}}" placeholder="{{localize 'NOIR.Custom'}}">
      </div>
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Drive"}}</span></h4>
        <div class="chips big">{{#each drives}}<a class="chip {{#if on}}on{{/if}}" data-action="chip" data-field="drive" data-value="{{value}}">{{value}}</a>{{/each}}</div>
        <input type="text" class="wide" data-bind="drive" value="{{drive}}" placeholder="{{localize 'NOIR.Custom'}}">
      </div>
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.PastLabel"}}</span></h4>
        <textarea data-bind="past" rows="4" placeholder="{{localize 'NOIR.PastHint'}}">{{past}}</textarea>
      </div>
    {{/if}}

    {{#if t.gear}}
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Armor"}}</span></h4>
        <div class="slot {{#if armor}}filled{{/if}}" data-action="pick" data-kind="armor" data-drop="armor">
          {{#if armor}}{{#if armor.img}}<img class="pic" src="{{armor.img}}" alt="">{{else}}<i class="glyph g-armor big"></i>{{/if}}<div class="info"><b>{{armor.name}}</b><span>{{armor.detail}}</span></div><a class="x" data-action="clear" data-kind="armor">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.armor"}}</span><span class="plus">＋</span>{{/if}}
        </div>
      </div>
      <div class="group">
        <h4 class="legend"><span>{{localize "NOIR.Weapons"}}</span></h4>
        <div class="slot {{#if main}}filled{{/if}}" data-action="pick" data-kind="main" data-drop="main">
          {{#if main}}{{#if main.img}}<img class="pic" src="{{main.img}}" alt="">{{else}}<i class="glyph g-weapon big"></i>{{/if}}<div class="info"><b>{{main.name}}</b><span>{{main.detail}}</span></div><a class="x" data-action="clear" data-kind="main">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.main"}}</span><span class="plus">＋</span>{{/if}}
        </div>
        <div class="slot {{#if sub}}filled{{/if}}" data-action="pick" data-kind="sub" data-drop="sub">
          {{#if sub}}{{#if sub.img}}<img class="pic" src="{{sub.img}}" alt="">{{else}}<i class="glyph g-weapon big"></i>{{/if}}<div class="info"><b>{{sub.name}}</b><span>{{sub.detail}}</span></div><a class="x" data-action="clear" data-kind="sub">✕</a>
          {{else}}<span class="ph">{{localize "NOIR.Pick.sub"}}</span><span class="plus">＋</span>{{/if}}
        </div>
      </div>
      <div class="three">
        <div class="col"><h4 class="legend small"><span>{{localize "NOIR.StartItems"}}</span></h4>
          {{#each kitItems}}<div class="opt fixed">{{this}}</div>{{/each}}
          <div class="opt fixed cash">${{cash}}</div></div>
        <div class="col"><h4 class="legend small"><span>{{localize "NOIR.Choice"}}</span></h4>
          {{#each choiceA}}<a class="opt {{#if on}}on{{/if}}" data-action="chip" data-field="choiceA" data-value="{{id}}"><img class="pic xs" src="{{img}}" alt="">{{name}}</a>{{/each}}</div>
        <div class="col"><h4 class="legend small"><span>{{localize "NOIR.Choice"}}</span></h4>
          {{#each choiceB}}<a class="opt {{#if on}}on{{/if}}" data-action="chip" data-field="choiceB" data-value="{{id}}"><img class="pic xs" src="{{img}}" alt="">{{name}}</a>{{/each}}</div>
      </div>
    {{/if}}

    </div>
    <footer class="foot">
      <button type="button" class="btn ghost" data-action="cancel">{{localize "NOIR.Cancel"}}</button>
      {{#if canBack}}<button type="button" class="btn ghost" data-action="back">{{localize "NOIR.Back"}}</button>{{/if}}
      {{#if isLast}}<button type="button" class="btn primary" data-action="finish" {{#unless allDone}}disabled{{/unless}}>{{localize "NOIR.Finish"}}</button>
      {{else}}<button type="button" class="btn primary" data-action="next" {{#unless canNext}}disabled{{/unless}}>{{localize "NOIR.Next"}}</button>{{/if}}
    </footer>
  </section></div>
</div>
